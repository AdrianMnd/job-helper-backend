// Esquema de base de datos - Asistente de busqueda de empleo
// Genera el cliente tipado de Prisma a partir de este archivo (npx prisma generate)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  profile      Profile?
  applications Application[]

  @@map("users")
}

// Perfil base del usuario: la "materia prima" que Gemini adapta a cada oferta.
// Se guarda en JSON en vez de tablas normalizadas (experience/education) porque
// no necesitamos consultarlo por campos individuales, solo pasarlo completo al prompt.
model Profile {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  fullName   String   @map("full_name")
  summary    String?
  experience Json     @default("[]")
  education  Json     @default("[]")
  skills     Json     @default("[]")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

enum ApplicationStatus {
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model Application {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  company         String
  position        String
  jobDescription  String            @map("job_description")
  jobUrl          String?           @map("job_url")
  status          ApplicationStatus @default(APPLIED)
  appliedDate     DateTime?         @map("applied_date")
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedDocuments GeneratedDocument[]
  statusHistory      StatusHistory[]

  @@index([userId])
  @@map("applications")
}

enum DocumentType {
  CV
  COVER_LETTER
}

// Cada generacion crea una fila nueva (no se sobreescribe la anterior).
// Esto es lo que permite comparar versiones y prompts entre si mas adelante.
model GeneratedDocument {
  id            String       @id @default(uuid())
  applicationId String       @map("application_id")
  docType       DocumentType @map("doc_type")
  version       Int
  content       String
  promptUsed    String       @map("prompt_used")
  modelParams   Json         @map("model_params") // { temperature, topP, model, ... }
  createdAt     DateTime     @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, docType])
  @@map("generated_documents")
}

// Historial de cambios de estado. Se escribe desde ya (aunque la UI de timeline
// sea fase 2) para no perder datos retroactivamente cuando la quieras mostrar.
model StatusHistory {
  id            String            @id @default(uuid())
  applicationId String            @map("application_id")
  status        ApplicationStatus
  changedAt     DateTime          @default(now()) @map("changed_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("status_history")
}
